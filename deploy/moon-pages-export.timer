[Unit]
Description=Publish MOON data every five minutes during weekday trading windows

[Timer]
OnCalendar=Mon..Fri *-*-* 08:50,55:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 09..14:00/5:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 15:00,05,10,15,20:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 20:50,55:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 21..23:00/5:00 Asia/Shanghai
OnCalendar=Tue..Sat *-*-* 00..01:00/5:00 Asia/Shanghai
OnCalendar=Tue..Sat *-*-* 02:00,05,10,15,20,25,30:00 Asia/Shanghai
Persistent=false
AccuracySec=1s

[Install]
WantedBy=timers.target
